<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            Show the repair on the work order, so someone looking at the board
            can see what the work is for.

            Core has no standalone form view for mrp.workorder: operations are
            edited in the editable list inside the manufacturing order. The
            repair column therefore goes in that list, hidden by default so it
            does not clutter manufacturing orders that carry no repair.
        -->
        <record id="view_mrp_production_workorder_tree_bridge" model="ir.ui.view">
            <field name="name">mrp.production.work.order.list.bridge</field>
            <field name="model">mrp.workorder</field>
            <field name="inherit_id" ref="mrp.mrp_production_workorder_tree_editable_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="repair_ids" widget="many2many_tags"
                           optional="hide" readonly="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
